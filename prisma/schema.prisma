// NeuroLearn — Prisma Schema
// PostgreSQL + pgvector via Neon

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [pgvector(map: "vector", schema: "public"), citext]
}

// ─── Auth ─────────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique @db.Citext
  emailVerified DateTime?
  name          String?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Subscription
  plan          Plan      @default(FREE)
  planExpiresAt DateTime?
  stripeCustomerId String? @unique

  // Learning stats (denormalized for performance)
  streakDays    Int       @default(0)
  lastStudiedAt DateTime?
  totalXp       Int       @default(0)

  accounts      Account[]
  sessions      Session[]
  subjects      Subject[]
  chatMessages  ChatMessage[]
  analyticsEvents AnalyticsEvent[]
  uploadedFiles UploadedFile[]
  revisionSessions RevisionSession[]
  quizSessions  QuizSession[]

  @@index([email])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Learning Content ──────────────────────────────────────────────────────────

model Subject {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  color       String   @default("#6366f1") // hex color for UI
  emoji       String   @default("📚")
  examDate    DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Denormalized stats
  cardCount   Int      @default(0)
  masteryPct  Float    @default(0)

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  topics      Topic[]
  uploadedFiles UploadedFile[]
  quizSessions QuizSession[]

  @@index([userId])
  @@index([userId, examDate])
}

model Topic {
  id          String   @id @default(cuid())
  subjectId   String
  name        String
  description String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subject     Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  cards       Card[]
  uploadedFiles UploadedFile[]

  @@index([subjectId])
  @@index([subjectId, order])
}

// ─── Flashcards + SM-2 ────────────────────────────────────────────────────────

model Card {
  id          String   @id @default(cuid())
  topicId     String
  front       String   @db.Text
  back        String   @db.Text
  hint        String?
  tags        String[]

  // SM-2 fields
  easeFactor  Float    @default(2.5)   // EF: 1.3–2.5
  interval    Int      @default(1)     // days until next review
  repetitions Int      @default(0)     // successful reviews
  dueAt       DateTime @default(now())
  lastReviewed DateTime?

  // Quality stats
  avgQuality  Float    @default(0)
  reviewCount Int      @default(0)

  // Source
  sourceType  CardSource @default(MANUAL)
  quizSessionId String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  topic       Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  attempts    QuizAttempt[]

  @@index([topicId])
  @@index([topicId, dueAt])
  @@index([dueAt])
}

enum CardSource {
  MANUAL
  AI_GENERATED
  PDF_EXTRACTED
}

// ─── Quiz System ───────────────────────────────────────────────────────────────

model QuizSession {
  id          String      @id @default(cuid())
  userId      String
  subjectId   String?
  mode        QuizMode    @default(STANDARD)
  status      QuizStatus  @default(IN_PROGRESS)

  // Timing
  startedAt   DateTime    @default(now())
  completedAt DateTime?
  timeLimitSec Int?

  // Results
  totalCards  Int         @default(0)
  correctCount Int        @default(0)
  score       Float?      // 0–100

  // Source file for AI-generated quizzes
  uploadedFileId String?

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject     Subject?    @relation(fields: [subjectId], references: [id])
  attempts    QuizAttempt[]

  @@index([userId])
  @@index([userId, status])
  @@index([userId, startedAt])
}

enum QuizMode {
  STANDARD
  TIMED
  EMERGENCY
  EXAM_PREP
}

enum QuizStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

model QuizAttempt {
  id            String   @id @default(cuid())
  quizSessionId String
  cardId        String
  quality       Int      // SM-2 quality: 0–5
  timeTakenMs   Int?
  wasCorrect    Boolean
  answeredAt    DateTime @default(now())

  quizSession   QuizSession @relation(fields: [quizSessionId], references: [id], onDelete: Cascade)
  card          Card        @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([quizSessionId])
  @@index([cardId])
}

// ─── Revision Sessions (SM-2 review) ─────────────────────────────────────────

model RevisionSession {
  id          String   @id @default(cuid())
  userId      String
  mode        RevisionMode @default(NORMAL)
  startedAt   DateTime @default(now())
  completedAt DateTime?
  cardsReviewed Int    @default(0)
  xpEarned    Int      @default(0)

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, startedAt])
}

enum RevisionMode {
  NORMAL
  EMERGENCY
  EXAM_PREP
}

// ─── AI Tutor Chat ────────────────────────────────────────────────────────────

model ChatMessage {
  id          String      @id @default(cuid())
  userId      String
  role        MessageRole
  content     String      @db.Text
  citations   Json?       // [{chunkId, text, similarity}]
  model       String?     // which model responded
  tokens      Int?
  createdAt   DateTime    @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, createdAt])
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

// ─── File Storage + RAG ───────────────────────────────────────────────────────

model UploadedFile {
  id          String     @id @default(cuid())
  userId      String
  subjectId   String?
  topicId     String?
  filename    String
  blobUrl     String
  mimeType    String
  sizeBytes   Int
  status      FileStatus @default(PENDING)
  errorMsg    String?
  chunkCount  Int        @default(0)
  createdAt   DateTime   @default(now())
  processedAt DateTime?

  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject     Subject?   @relation(fields: [subjectId], references: [id])
  topic       Topic?     @relation(fields: [topicId], references: [id])
  chunks      ChunkEmbedding[]

  @@index([userId])
  @@index([userId, status])
}

enum FileStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

model ChunkEmbedding {
  id           String                  @id @default(cuid())
  fileId       String
  chunkIndex   Int
  content      String                  @db.Text
  embedding    Unsupported("vector(3072)")?
  tokenCount   Int
  createdAt    DateTime                @default(now())

  file         UploadedFile            @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([fileId])
  // HNSW index is created via raw SQL migration (see migrations/)
}

// ─── Analytics ────────────────────────────────────────────────────────────────

model AnalyticsEvent {
  id        String   @id @default(cuid())
  userId    String
  event     String   // e.g. "quiz.completed", "card.reviewed"
  props     Json?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, event])
  @@index([userId, createdAt])
  @@index([createdAt])
}

enum Plan {
  FREE
  PRO
  TEAM
}
